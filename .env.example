# ============================================================
# Root Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Database ----
DATABASE_URL="postgresql://postgres:password@localhost:5432/marketup"
DIRECT_URL="postgresql://postgres:password@localhost:5432/marketup"

# ---- JWT ----
# Bắt buộc, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Tuỳ chọn: thư mục lưu ảnh (mặc định "marketup"); đặt khác nhau cho dev/prod, vd. "marketup-dev"
CLOUDINARY_FOLDER=""

# ---- Email ----
# Không đặt gì: email (kể cả mã đăng nhập người mua) chỉ được in ra log — đủ cho máy dev.
# Production trên Render dùng Brevo (API HTTPS) vì gói miễn phí của Render chặn mọi cổng SMTP.
BREVO_API_KEY=""
# Hoặc SMTP (máy local / tự host); bị bỏ qua khi có BREVO_API_KEY
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Người gửi; với Brevo, địa chỉ phải là sender đã xác minh trong tài khoản Brevo
SMTP_FROM="MarketUp <you@example.com>"

# ---- Stripe ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- App URLs ----
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FRONTEND_URL="https://your-app.vercel.app"
API_PORT=3001

# ---- Next.js ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---- API (production) ----
# Số proxy đứng trước API (Render). Đo bằng GET /api/health/client-ip sau khi deploy.
TRUST_PROXY_HOPS="0"
