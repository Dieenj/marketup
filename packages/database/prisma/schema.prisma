// Đây là file schema Prisma của bạn
// Tìm hiểu thêm trong tài liệu: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Các Enum
// ============================================================

enum Role {
  SELLER
  ADMIN
}

enum OrderStatus {
  PENDING    // Đang chờ xác nhận
  CONFIRMED  // Đã xác nhận
  PROCESSING // Đang xử lý
  SHIPPING   // Đang giao hàng
  DELIVERED  // Đã giao hàng
  CANCELLED  // Đã hủy
}

// Ai huỷ đơn
enum CancelActor {
  BUYER
  SELLER
}

// Lý do huỷ (giống Shopee): người mua chỉ huỷ khi shop chưa xác nhận;
// đơn đang giao chỉ có thể "giao không thành công" (vd. người mua từ chối nhận hàng COD)
enum CancelReason {
  CHANGED_MIND       // Người mua: không muốn mua nữa
  WRONG_DETAILS      // Người mua: muốn đổi địa chỉ / sản phẩm
  FOUND_BETTER_PRICE // Người mua: tìm được chỗ rẻ hơn
  OUT_OF_STOCK       // Shop: hết hàng
  BUYER_UNREACHABLE  // Shop: không liên lạc được người mua
  DELIVERY_FAILED    // Shop: giao không thành công
  OTHER
}


// ============================================================
// Các Model
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SELLER)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Các mối quan hệ
  shop Shop?

  @@map("users")
}

model Shop {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl      String?
  bannerUrl    String?
  primaryColor String?  @default("#111111")
  contactEmail String?
  contactPhone String?
  address      String?
  isActive     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Các mối quan hệ
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String       @unique
  products   Product[]
  categories Category[]
  orders     Order[]
  reviews    Review[]

  @@map("shops")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Các mối quan hệ
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId    String
  products  Product[]

  @@unique([shopId, slug])
  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  images      String[]
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Các mối quan hệ
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      String
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  orderItems  OrderItem[]
  attributes  ProductAttribute[]
  variants    ProductVariant[]
  reviews     Review[]

  @@map("products")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // VD: ORD-2024-001
  
  // Thông tin người mua (thanh toán khách - không cần tài khoản)
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  
  // Giao hàng
  shippingAddress String
  shippingCity    String
  shippingDistrict String?
  shippingNote    String?
  
  // Giá cả
  subtotal        Decimal       @db.Decimal(12, 2)
  shippingFee     Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  
  // Trạng thái
  status          OrderStatus   @default(PENDING)
  
  // Mốc thời gian
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deliveredAt     DateTime?

  // Huỷ đơn
  cancelledAt     DateTime?
  cancelledBy     CancelActor?
  cancelReason    CancelReason?
  cancelNote      String?

  // Các mối quan hệ
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shopId          String
  items           OrderItem[]

  // Người mua đăng nhập bằng email → liệt kê đơn theo email trong từng shop
  @@index([buyerEmail, shopId])
  // Danh sách đơn của shop ở dashboard: mới nhất trước, từng trang
  @@index([shopId, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String          @id @default(cuid())
  quantity         Int
  priceAtPurchase  Decimal         @db.Decimal(12, 2)
  productName      String
  productImage     String?
  variantLabel     String?         // Lưu ảnh chụp (Snapshot): "Size: M / Color: Red"

  // Các mối quan hệ
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId        String
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId        String?
  review           Review?

  @@map("order_items")
}

model ProductAttribute {
  id        String   @id @default(cuid())
  name      String   // Ví dụ: "Kích cỡ", "Màu sắc", "Chất liệu"
  options   String[] // Ví dụ: ["S", "M", "L", "XL"]
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@map("product_attributes")
}

model ProductVariant {
  id           String   @id @default(cuid())
  label        String   // Ví dụ: "Size: M / Color: Red" hoặc "Mặc định" nếu không có biến thể
  options      Json     // Ví dụ: {"Size": "M", "Color": "Red"} hoặc {}
  price        Decimal  @db.Decimal(12, 2)
  comparePrice Decimal? @db.Decimal(12, 2)
  stock        Int      @default(0)
  sku          String?
  isDefault    Boolean  @default(false) // Biến thể mặc định để hiển thị
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  orderItems OrderItem[]

  @@map("product_variants")
}

// Đánh giá kiểu Shopee: chỉ từ sản phẩm trong đơn đã giao, mỗi sản phẩm của đơn tối đa một đánh giá,
// trong 30 ngày sau khi giao, người mua sửa được một lần; shop chỉ trả lời (không ẩn/xoá).
model Review {
  id              String    @id @default(cuid())
  rating          Int       // Từ 1 đến 5 sao
  comment         String?   @db.Text
  buyerName       String    // Tên hiển thị đã che (vd. "M***u") — chụp lúc viết
  editedAt        DateTime? // Người mua đã sửa (chỉ được một lần)
  sellerReply     String?   @db.Text
  sellerRepliedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Các mối quan hệ
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId      String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId String    @unique

  @@index([productId, createdAt])
  @@index([shopId, createdAt])
  @@map("reviews")
}

// Mã đăng nhập một lần (OTP) gửi qua email cho người mua — chỉ lưu bản băm
model BuyerLoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@map("buyer_login_codes")
}
